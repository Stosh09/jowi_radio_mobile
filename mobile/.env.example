# JOWI 98.1 FM mobile — copy to `.env` and fill in (same Supabase project as the website).
# Expo inlines EXPO_PUBLIC_* variables into the app bundle — never put secrets here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://auawjenbkghmnlhknfmy.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Shared booth account email (Supabase Auth user). Password = studio PIN.
EXPO_PUBLIC_BOOTH_EMAIL=studio@jowi981fm.com

# Optional overrides (default to the Supabase Edge Functions on the project above)
# EXPO_PUBLIC_LISTENERS_URL=https://auawjenbkghmnlhknfmy.supabase.co/functions/v1/listeners
# EXPO_PUBLIC_EXTRACT_URL=https://auawjenbkghmnlhknfmy.supabase.co/functions/v1/extract-bulletin
# EXPO_PUBLIC_PUSH_URL=https://auawjenbkghmnlhknfmy.supabase.co/functions/v1/send-push

# Public website, used in "Share I'm listening"
EXPO_PUBLIC_SITE_URL=https://jowi981.fm
