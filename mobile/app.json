{
  "expo": {
    "name": "JOWI 98.1 FM",
    "slug": "jowi-radio",
    "scheme": "jowi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/jowi/icons/app-icon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c0e",
    "primaryColor": "#e8a317",
    "description": "Listen live to JOWI 98.1 FM — jamuomo. Schedule, presenters, shoutouts, song requests and live polls.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fm.jowi981.radio"
    },
    "android": {
      "package": "fm.jowi981.radio",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/jowi/icons/adaptive-foreground-1024.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
        "image": "./assets/jowi/icons/splash-icon.png",
        "imageWidth": 240,
        "resizeMode": "contain",
        "backgroundColor": "#4a0f07"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e8a317",
          "defaultChannel": "broadcasts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JOWI to attach photos of news notices to booth bulletins.",
          "cameraPermission": "Allow JOWI to photograph news notices for booth bulletins.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4544aa50-06bc-4dea-be79-23211d8e6783"
      }
    },
    "owner": "stosh.w",
    "updates": {
      "url": "https://u.expo.dev/4544aa50-06bc-4dea-be79-23211d8e6783"
    }
  }
}
