# JOWI 98.1 FM — environment template
# Copy to `.env` and fill in values from the Supabase dashboard.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Shared booth account email (Supabase Auth user). Password = studio PIN.
# Use a normal domain — Supabase rejects some TLDs (e.g. .fm).
# Create this user in Supabase → Authentication → Users (or first PIN login will try signUp).
VITE_BOOTH_EMAIL=studio@jowi981fm.com

# Live listener count — prefer Supabase Edge Function in production so open
# tabs do not burn Vercel Hobby function invocations.
# Deploy: supabase functions deploy listeners --no-verify-jwt
# Local/dev can leave this unset (uses Vite proxy /api/listeners).
# Production builds auto-derive from VITE_SUPABASE_URL when this is unset.
VITE_LISTENERS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/listeners

# Optional: override AI extract Edge Function URL (defaults to Supabase project)
# VITE_EXTRACT_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/extract-bulletin

# Server-only secrets (never VITE_) — set in Supabase Dashboard → Edge Functions → Secrets
# GEMINI_API_KEY=your_google_ai_studio_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
